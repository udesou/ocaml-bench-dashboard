{
  "title": "manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_produced_by": { "default": null, "type": [ "string", "null" ] },
    "benchmarks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tags": {
            "default": [],
            "type": "array",
            "items": { "type": "string" }
          },
          "suite": { "type": "string" },
          "name": { "type": "string" }
        },
        "required": [ "suite", "name" ],
        "additionalProperties": false
      }
    },
    "comparisons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "baseline_at": {
            "default": null,
            "anyOf": [ { "type": "object" }, { "type": "null" } ]
          },
          "fix": {
            "default": null,
            "anyOf": [ { "type": "object" }, { "type": "null" } ]
          },
          "variants": {
            "default": null,
            "anyOf": [
              { "type": "array", "items": { "type": "object" } },
              { "type": "null" }
            ]
          },
          "baseline": {
            "default": null,
            "anyOf": [ { "type": "object" }, { "type": "null" } ]
          },
          "mode": { "default": null, "type": [ "string", "null" ] },
          "over": { "default": null, "anyOf": [ {}, { "type": "null" } ] },
          "label": { "default": null, "type": [ "string", "null" ] },
          "kind": { "type": "string" }
        },
        "required": [ "kind" ],
        "additionalProperties": false
      }
    },
    "configs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "_modifiers": {
            "default": [],
            "type": "array",
            "items": { "type": "string" }
          },
          "_runtime_name": { "default": null, "type": [ "string", "null" ] },
          "tools": {
            "default": [],
            "type": "array",
            "items": { "type": "string" }
          },
          "dimensions": { "default": [], "type": "object" },
          "runtime": {
            "type": "object",
            "properties": {
              "options": {
                "default": [],
                "type": "array",
                "items": { "type": "string" }
              },
              "commit": { "default": null, "type": [ "string", "null" ] },
              "version": { "type": "string" },
              "kind": { "type": "string" }
            },
            "required": [ "version", "kind" ],
            "additionalProperties": false
          },
          "config_id": { "type": "string" }
        },
        "required": [ "runtime", "config_id" ],
        "additionalProperties": false
      }
    },
    "tool_versions": {
      "default": [],
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "machine": {
      "type": "object",
      "properties": {
        "turbo": { "default": null, "type": [ "boolean", "null" ] },
        "isolcpus": { "default": null, "type": [ "string", "null" ] },
        "governor": { "default": null, "type": [ "string", "null" ] },
        "kernel": { "default": null, "type": [ "string", "null" ] },
        "cores": { "default": null, "type": [ "integer", "null" ] },
        "cpu_model": { "default": null, "type": [ "string", "null" ] },
        "hostname": { "type": "string" }
      },
      "required": [ "hostname" ],
      "additionalProperties": false
    },
    "created_at": { "type": "string" },
    "run_id": { "type": "string" },
    "schema_version": { "type": "string" }
  },
  "required": [ "machine", "created_at", "run_id", "schema_version" ],
  "additionalProperties": false
}

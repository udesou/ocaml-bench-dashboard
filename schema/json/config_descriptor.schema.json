{
  "title": "config_descriptor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_modifiers": {
      "default": [],
      "type": "array",
      "items": { "type": "string" }
    },
    "_runtime_name": { "default": null, "type": [ "string", "null" ] },
    "tools": {
      "default": [],
      "type": "array",
      "items": { "type": "string" }
    },
    "dimensions": { "default": [], "type": "object" },
    "runtime": {
      "type": "object",
      "properties": {
        "options": {
          "default": [],
          "type": "array",
          "items": { "type": "string" }
        },
        "commit": { "default": null, "type": [ "string", "null" ] },
        "version": { "type": "string" },
        "kind": { "type": "string" }
      },
      "required": [ "version", "kind" ],
      "additionalProperties": false
    },
    "config_id": { "type": "string" }
  },
  "required": [ "runtime", "config_id" ],
  "additionalProperties": false
}

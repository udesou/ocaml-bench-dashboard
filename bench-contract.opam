opam-version: "2.0"
version: "1.0.0"
synopsis:
  "OCaml benchmarking data contract: canonical types, registries, validators"
description: """
Canonical OCaml types for the benchmarking data contract (measurement
records, run manifest, config descriptors, comparisons), the metric and
dimension registries, and JSON (de)serializers that double as validators.
Shared by the ingestor and by runner-side adapters/emitters so there is a
single source of truth for the contract. The package version tracks the
contract's schema_version."""
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "yojson"
  "ppx_deriving_yojson"
  "ppx_deriving_jsonschema"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
